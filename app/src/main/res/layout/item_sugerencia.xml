<?xml version="1.0" encoding="utf-8"?>
<!-- Sugerencia (430:2335), Tono=Franja: ancho completo, ícono de 22, texto de 14 y botón de cerrar (Cerrable) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sugerencia"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:tint="@color/brand_primary"
        tools:src="@drawable/ic_info" />

    <TextView
        android:id="@+id/tv_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
        android:textColor="@color/brand_on_container"
        tools:text="@string/home_tip_how_it_works" />

    <!-- Ícono de 18 con área táctil de 48 -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/home_tip_close"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:tint="@color/brand_on_container" />
</LinearLayout>
