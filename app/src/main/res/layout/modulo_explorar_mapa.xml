<?xml version="1.0" encoding="utf-8"?>
<!-- Módulo / Explorar en mapa (compacto) (481:2342): mapa de 100 y una línea de texto.
     La ilustración usa las medidas del diseño (340 de ancho de referencia); lo que sobra se recorta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_sm">

    <!-- Tarjeta (481:2343): se recorta a sus esquinas redondeadas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_property_card"
        android:clipToOutline="true"
        android:orientation="vertical">

        <!-- Mapa en miniatura (481:2344) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/map_block"
            android:importantForAccessibility="no">

            <View
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:layout_marginStart="196dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_map_park" />

            <View
                android:layout_width="340dp"
                android:layout_height="10dp"
                android:layout_marginTop="92dp"
                android:background="@color/map_road" />

            <View
                android:layout_width="340dp"
                android:layout_height="6dp"
                android:layout_marginTop="40dp"
                android:background="@color/map_road" />

            <View
                android:layout_width="10dp"
                android:layout_height="160dp"
                android:layout_marginStart="120dp"
                android:background="@color/map_road" />

            <View
                android:layout_width="6dp"
                android:layout_height="160dp"
                android:layout_marginStart="40dp"
                android:background="@color/map_road" />

            <View
                android:layout_width="6dp"
                android:layout_height="160dp"
                android:layout_marginStart="262dp"
                android:background="@color/map_road" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_marginTop="68dp"
                android:background="@drawable/bg_map_pin_mini"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/explore_map_pin_a"
                android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="212dp"
                android:layout_marginTop="66dp"
                android:background="@drawable/bg_map_pin_mini"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/explore_map_pin_b"
                android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Cuerpo (481:2357) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/explore_map_title"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/explore_map_text"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_explorar_mapa"
                style="@style/Widget.Miarriendo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/explore_map_button" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
