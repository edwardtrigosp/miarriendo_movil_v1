<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de lista en carga (624:8047): ícono de 40 y una línea -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingVertical="@dimen/spacing_sm">

    <View
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_esqueleto_circulo" />

    <View
        android:layout_width="190dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:background="@drawable/bg_esqueleto" />
</LinearLayout>
