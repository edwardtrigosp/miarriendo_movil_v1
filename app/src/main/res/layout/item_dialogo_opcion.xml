<?xml version="1.0" encoding="utf-8"?>
<!-- ListItem (635:3278) dentro de un diálogo de lista: ícono en círculo, nombre y flecha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_xs">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_surface_high"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_home_work"
        app:tint="@color/brand_on_container" />

    <TextView
        android:id="@+id/tv_option"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium"
        android:textColor="@color/text_primary"
        tools:text="Apartamento Centro" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_secondary" />
</LinearLayout>
