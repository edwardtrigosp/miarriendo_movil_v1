<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de detalle del diseño (Detalle): título opcional y filas item_dato que se agregan desde el código. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_border"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <TextView
        android:id="@+id/tv_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
        android:visibility="gone"
        tools:text="Noviembre de 2026"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/card_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
