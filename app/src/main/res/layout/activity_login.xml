<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma: Onboarding / Login - Default (209:619), Error (209:682), Cargando (209:741),
    Con huella (210:741) y Huella cambiada (209:793).
    mode_password cubre Default/Error/Cargando/Huella cambiada; mode_biometric cubre Con huella.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- ===== Ingreso con contraseña ===== -->
        <LinearLayout
            android:id="@+id/mode_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_brand_container"
                android:contentDescription="@string/login_logo"
                android:padding="14dp"
                android:src="@drawable/ic_home" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/login_title"
                android:textAppearance="@style/TextAppearance.Miarriendo.H1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/login_subtitle"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />

            <!-- Alert: Huella cambiada (Advertencia) o correo de recuperación enviado (Info) -->
            <include
                android:id="@+id/alert_login"
                layout="@layout/view_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:visibility="gone" />

            <!-- Campos: gap 24 (margen 16 + 8 de la etiqueta flotante) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.Miarriendo.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/field_email"
                app:placeholderText="@string/field_email_hint_login"
                app:startIconDrawable="@drawable/ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    style="@style/Widget.Miarriendo.TextField.EditText"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.Miarriendo.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/field_password"
                app:placeholderText="@string/field_password_hint_login"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    style="@style/Widget.Miarriendo.TextField.EditText"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_forgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackground"
                android:text="@string/login_forgot"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/spacing_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                style="@style/Widget.Miarriendo.Button.Primary"
                android:layout_width="match_parent"
                android:text="@string/login_button"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_xs"
                app:iconSize="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_new_user"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall" />

                <TextView
                    android:id="@+id/tv_create_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_micro"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/login_create_account"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Ingreso con huella (usuario que vuelve) ===== -->
        <LinearLayout
            android:id="@+id/mode_biometric"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header igual al del login Default, con la huella en el círculo -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_brand_container"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/brand_primary" />

            <TextView
                android:id="@+id/tv_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/login_welcome_back_generic"
                android:textAppearance="@style/TextAppearance.Miarriendo.H1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/login_fingerprint_subtitle"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/spacing_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_use_fingerprint"
                style="@style/Widget.Miarriendo.Button.Primary"
                android:layout_width="match_parent"
                android:text="@string/login_use_fingerprint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_use_password"
                style="@style/Widget.Miarriendo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/login_use_password" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
