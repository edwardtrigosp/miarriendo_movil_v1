<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Inicio · Explorar arriendos (315:6469) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".InquilinoInicioActivity">

    <!-- Marca (321:1146): saludo + Acciones (Avatar que abre el perfil y Mis solicitudes) -->
    <LinearLayout style="@style/Widget.Miarriendo.TopAppBar">

        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.Miarriendo.H3"
            tools:text="Hola Edward!" />

        <TextView
            android:id="@+id/tv_avatar"
            style="@style/Widget.Miarriendo.Avatar"
            android:layout_marginStart="@dimen/spacing_micro"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:contentDescription="@string/owner_open_profile"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            tools:text="ET" />

        <ImageButton
            android:id="@+id/btn_my_requests"
            style="@style/Widget.Miarriendo.IconButton"
            android:contentDescription="@string/tenant_my_requests"
            android:src="@drawable/ic_notifications" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_lg">

                <!-- Arriendo activo: abre Mi arriendo -->
                <include
                    android:id="@+id/banner_rental"
                    layout="@layout/view_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:visibility="gone" />

                <!-- Buscar y filtrar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_search"
                        style="@style/Widget.Miarriendo.TextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/tenant_search_label"
                        app:placeholderText="@string/field_city_hint"
                        app:startIconDrawable="@drawable/ic_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_search"
                            style="@style/Widget.Miarriendo.TextField.EditText"
                            android:imeOptions="actionSearch"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Abre Inquilino / Mapa · Explorar arriendos (342:2892) -->
                    <ImageButton
                        android:id="@+id/btn_map"
                        style="@style/Widget.Miarriendo.IconButton"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:contentDescription="@string/map_open"
                        android:src="@drawable/ic_map" />

                    <ImageButton
                        android:id="@+id/btn_filters"
                        style="@style/Widget.Miarriendo.IconButton"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:contentDescription="@string/tenant_filters"
                        android:src="@drawable/ic_tune" />
                </LinearLayout>

                <!-- Encabezado de listado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tenant_for_you"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

                    <TextView
                        android:id="@+id/tv_available"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        tools:text="3 disponibles" />
                </LinearLayout>

                <!-- La primera propiedad va en PropertyCard y las demás en tarjeta compacta -->
                <LinearLayout
                    android:id="@+id/list_properties"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tenant_empty"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary" />
    </FrameLayout>
</LinearLayout>
