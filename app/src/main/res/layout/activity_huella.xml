<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Propietario / Ingreso con huella - Desactivado (202:561), Activado (202:595), No disponible (204:619) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".HuellaActivity">

    <!-- NavBar -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="-6dp"
        android:layout_marginBottom="-6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Content Area: px 24, pt 16, pb 40, gap 24 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Header: emblema 80 + títulos (gap 16) -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle_brand_container"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/brand_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/bio_screen_title"
                android:textAppearance="@style/TextAppearance.Miarriendo.H1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bio_screen_subtitle"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />

            <!-- ListItem / Toggle (201:579) -->
            <LinearLayout
                android:id="@+id/row_biometric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card_list"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_brand_container"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/brand_on_container" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_toggle_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/sw_biometric"
                        android:text="@string/bio_toggle_label"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_toggle_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                        android:textColor="@color/text_secondary"
                        tools:text="@string/bio_state_off" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_biometric"
                    style="@style/Widget.Miarriendo.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:contentDescription="@string/bio_toggle_label" />
            </LinearLayout>

            <!-- Solo en "No disponible": SecondaryButton Default -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_settings"
                style="@style/Widget.Miarriendo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/bio_open_settings"
                android:visibility="gone"
                app:icon="@drawable/ic_settings"
                tools:visibility="visible" />

            <include
                android:id="@+id/tip_biometric"
                layout="@layout/view_tip_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
