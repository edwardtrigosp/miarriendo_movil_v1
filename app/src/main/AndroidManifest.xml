<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ícono "my_location" del paso 2 de Publicar y "Centrar mapa" del mapa del inquilino -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- "Abrir Nequi para aprobar" del inicio: desde Android 11 hay que declarar la app que se abre -->
    <queries>
        <package android:name="com.nequi.MobileApp" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miarriendo_v1">

        <!-- Maps SDK for Android: la clave sale de MAPS_API_KEY en local.properties (ver app/build.gradle.kts) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegisterRoleActivity"
            android:exported="false" />
        <activity
            android:name=".PublicarPropiedadActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PublicandoActivity"
            android:exported="false" />
        <activity
            android:name=".PerfilActivity"
            android:exported="false" />
        <activity
            android:name=".HuellaActivity"
            android:exported="false" />
        <activity
            android:name=".PropiedadDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".InicioActivity"
            android:exported="false" />
        <activity
            android:name=".ContratoActivity"
            android:exported="false" />
        <activity
            android:name=".ReportarDanoActivity"
            android:exported="false" />
        <activity
            android:name=".InquilinoMapaActivity"
            android:exported="false" />
        <activity
            android:name=".FiltrosActivity"
            android:exported="false" />
        <activity
            android:name=".ResultadosActivity"
            android:exported="false" />
        <activity
            android:name=".DetalleArriendoActivity"
            android:exported="false" />
        <activity
            android:name=".SolicitarArriendoActivity"
            android:exported="false" />
        <activity
            android:name=".MisSolicitudesActivity"
            android:exported="false" />
        <activity
            android:name=".SolicitudesRecibidasActivity"
            android:exported="false" />
        <activity
            android:name=".MiArriendoActivity"
            android:exported="false" />
        <activity
            android:name=".PagarNequiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ConfirmarNequiActivity"
            android:exported="false" />
        <activity
            android:name=".ResultadoPagoActivity"
            android:exported="false" />
        <activity
            android:name=".ComprobanteActivity"
            android:exported="false" />
        <activity
            android:name=".HistorialInmuebleActivity"
            android:exported="false" />
        <activity
            android:name=".PagosInmuebleActivity"
            android:exported="false" />
        <activity
            android:name=".CuentaBancariaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- Comparte el PDF de resumen del contrato (Mi contrato → Descargar en PDF) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos" />
        </provider>
    </application>

</manifest>
