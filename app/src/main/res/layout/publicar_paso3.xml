<?xml version="1.0" encoding="utf-8"?>
<!-- Paso 3: Detalles y precio (127:1748) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md">
        <!-- Header: título H1 + subtítulo (patrón de Ingreso con huella) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/publish_step3_title"
            android:textAppearance="@style/TextAppearance.Miarriendo.H1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/publish_step3_subtitle"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_bedrooms"
            style="@style/Widget.Miarriendo.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/field_bedrooms"
            app:placeholderText="@string/field_bedrooms_hint"
            app:startIconDrawable="@drawable/ic_bed">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_bedrooms"
                style="@style/Widget.Miarriendo.TextField.EditText"
                android:inputType="number"
                android:maxLength="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_bathrooms"
            style="@style/Widget.Miarriendo.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/field_bathrooms"
            app:placeholderText="@string/field_bathrooms_hint"
            app:startIconDrawable="@drawable/ic_bathtub">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_bathrooms"
                style="@style/Widget.Miarriendo.TextField.EditText"
                android:inputType="number"
                android:maxLength="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_area"
            style="@style/Widget.Miarriendo.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/field_area"
            app:placeholderText="@string/field_area_hint"
            app:startIconDrawable="@drawable/ic_straighten">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_area"
                style="@style/Widget.Miarriendo.TextField.EditText"
                android:inputType="numberDecimal"
                android:maxLength="7" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_price"
            style="@style/Widget.Miarriendo.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/field_price"
            app:placeholderText="@string/field_price_hint"
            app:startIconDrawable="@drawable/ic_payments">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_price"
                style="@style/Widget.Miarriendo.TextField.EditText"
                android:inputType="number"
                android:maxLength="13" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/publish_amenities"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_amenities"
            style="@style/Widget.Miarriendo.ChipGroup"
            android:layout_marginTop="@dimen/spacing_sm">

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_parking" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_gym" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_pool" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_doorman" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_pets" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_furnished" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_terrace" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenity_balcony" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</ScrollView>
