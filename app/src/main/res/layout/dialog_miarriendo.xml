<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Dialog (627:2695) · Informativo, Confirmar y Destructivo. Lo arma la clase Dialogo: el contenido y la
     lista son opcionales, y el botón de confirmar cambia según el tono. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Miarriendo.H3"
        tools:text="¿Cerrar sesión?" />

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium"
        android:visibility="gone"
        tools:text="Tendrás que ingresar tu correo y contraseña para volver a entrar."
        tools:visibility="visible" />

    <!-- Campo, foto u otra vista propia del diálogo -->
    <FrameLayout
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:visibility="gone" />

    <!-- Opciones para elegir (ListItem) -->
    <LinearLayout
        android:id="@+id/dialog_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dialog_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_cancel"
            style="@style/Widget.Miarriendo.Button.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:visibility="gone"
            tools:text="@string/cancel"
            tools:visibility="visible" />

        <Space
            android:id="@+id/dialog_actions_gap"
            android:layout_width="@dimen/spacing_sm"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_confirm"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:visibility="gone"
            tools:text="Aceptar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_confirm_destructive"
            style="@style/Widget.Miarriendo.Button.Secondary.Destructivo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:visibility="gone"
            tools:text="Salir"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
