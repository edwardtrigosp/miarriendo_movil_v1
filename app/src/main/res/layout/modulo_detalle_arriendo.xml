<?xml version="1.0" encoding="utf-8"?>
<!-- Módulo / Recordatorios y detalle (531:3931): un ListItem "Detalles de mi arriendo" con borde inferior
     border/card. La tarjeta de recordatorios no se dibuja hasta que la app tenga recordatorios. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_lg">

    <include
        android:id="@+id/fila"
        layout="@layout/view_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/border_width"
        android:background="@color/border_card" />
</LinearLayout>
