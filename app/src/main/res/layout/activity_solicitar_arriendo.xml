<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Solicitar arriendo, una sola pantalla (547:2421): día de la visita, quiénes vivirían,
     mensaje opcional y un solo botón. La solicitud enviada se ve después en el inicio (Tu solicitud). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".SolicitarArriendoActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Día de la visita -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/request_visit_day"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                android:textColor="@color/text_primary" />

            <com.example.miarriendo_v1.CalendarioVisita
                android:id="@+id/calendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_card_border"
                android:padding="@dimen/spacing_sm" />

            <!-- Quién viviría: ¿Cuántas personas? -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/request_people"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                    android:textColor="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btn_menos"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_contador"
                    android:contentDescription="@string/request_people_less"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_personas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:gravity="center"
                    android:minWidth="12dp"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                    android:textColor="@color/text_primary"
                    tools:text="3" />

                <ImageButton
                    android:id="@+id/btn_mas"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_contador"
                    android:contentDescription="@string/request_people_more"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- ¿Tienen mascotas? No / Sí -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/request_pets"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_mascotas"
                    style="@style/Widget.Miarriendo.ChipGroup"
                    android:layout_width="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sin_mascotas"
                        style="@style/Widget.Miarriendo.Chip.Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/request_pets_no" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_con_mascotas"
                        style="@style/Widget.Miarriendo.Chip.Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/request_pets_yes" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Mensaje al propietario (opcional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_message"
                style="@style/Widget.Miarriendo.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:hint="@string/request_message_optional_generic"
                app:placeholderText="@string/request_message_example">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_message"
                    style="@style/Widget.Miarriendo.TextArea.EditText"
                    android:lineHeight="20sp"
                    android:maxLength="500"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/request_privacy_generic"
                android:textAppearance="@style/TextAppearance.Miarriendo.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Acciones: un solo botón, activo cuando hay un día elegido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:text="@string/request_send" />
    </LinearLayout>
</LinearLayout>
