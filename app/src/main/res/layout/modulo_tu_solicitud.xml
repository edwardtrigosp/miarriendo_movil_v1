<?xml version="1.0" encoding="utf-8"?>
<!-- Módulo / Tu solicitud (446:3671): En revisión · Aceptada · No aceptada -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/your_request_title"
            android:textAppearance="@style/TextAppearance.Miarriendo.H3" />

        <TextView
            android:id="@+id/tv_status"
            style="@style/Widget.Miarriendo.StatusChip"
            tools:text="En revisión" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
        tools:text="Casa Los Mayales" />

    <TextView
        android:id="@+id/tv_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_micro"
        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
        android:textColor="@color/text_secondary"
        tools:text="Calle 20 #12-35 · $1.200.000 COP/mes · Propietario: Edward" />

    <include
        android:id="@+id/pasos"
        layout="@layout/view_pasos_solicitud"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/spacing_md" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
        android:textColor="@color/text_secondary"
        tools:text="Edward está revisando tu solicitud. Aquí verás su respuesta." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_secondary"
        style="@style/Widget.Miarriendo.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/your_request_see"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_primary"
        style="@style/Widget.Miarriendo.Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/spacing_md"
        android:visibility="gone"
        tools:text="@string/your_request_see_rental" />
</LinearLayout>
