<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: MaintenanceItem (43:1702) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_list"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <ImageView
        style="@style/Widget.Miarriendo.IconCircle"
        android:src="@drawable/ic_build"
        app:tint="@color/text_secondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
            android:textColor="@color/text_primary"
            tools:text="Fuga en el lavamanos" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
            tools:text="Hace 2 días" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        style="@style/Widget.Miarriendo.StatusChip.Advertencia"
        android:layout_marginStart="@dimen/spacing_sm"
        tools:text="Nueva" />
</LinearLayout>
