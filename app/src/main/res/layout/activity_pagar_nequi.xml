<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Pagar completo y Pagar abono 1 de 3: resumen, celular Nequi y aceptación de Wompi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".PagarNequiActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Resumen de pago -->
            <include
                android:id="@+id/card_summary"
                layout="@layout/view_payment_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Periodo y saldo después del abono -->
            <include
                android:id="@+id/card_detail"
                layout="@layout/view_card_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone" />

            <!-- Método Nequi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nequi_method"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nequi_processor"
                    android:textAppearance="@style/TextAppearance.Miarriendo.Caption" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                style="@style/Widget.Miarriendo.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:hint="@string/nequi_phone_label"
                app:startIconDrawable="@drawable/ic_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_phone"
                    style="@style/Widget.Miarriendo.TextField.EditText"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:maxLength="16" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_phone_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/nequi_phone_help"
                android:textAppearance="@style/TextAppearance.Miarriendo.Caption" />

            <!-- Consentimiento de Wompi: la casilla se habilita cuando llegan los enlaces de los contratos -->
            <android.widget.CheckBox
                android:id="@+id/cb_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:button="@drawable/check_terms"
                android:enabled="false"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:text="@string/nequi_loading_terms"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_terms" />

            <include
                android:id="@+id/alert"
                layout="@layout/view_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_terms"
                style="@style/Widget.Miarriendo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/nequi_retry_terms"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pay"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:enabled="false"
            android:text="@string/nequi_pay" />
    </LinearLayout>
</LinearLayout>
