<?xml version="1.0" encoding="utf-8"?>
<!-- Módulo / Encabezado (446:3435). Fondo blanco (decisión del 13/10). El buscador y las sugerencias
     solo se ven en Rol=Inquilino sin arriendo (446:3419). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_default"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <!-- Contenido encabezado (446:3402) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg">

        <!-- Fila superior: Avatar → Perfil y notificaciones → Mis solicitudes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_avatar"
                style="@style/Widget.Miarriendo.Avatar"
                android:contentDescription="@string/owner_open_profile"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                tools:text="ML" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_notifications"
                style="@style/Widget.Miarriendo.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:padding="12dp"
                android:contentDescription="@string/tenant_my_requests"
                android:src="@drawable/ic_notifications" />
        </LinearLayout>

        <!-- Saludo (446:3408) -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Miarriendo.H1"
            tools:text="Hola, María" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_micro"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="@string/home_subtitle_search"
            tools:visibility="visible" />

        <!-- Buscador (446:3411): Enter abre Resultados; el botón abre Filtros -->
        <LinearLayout
            android:id="@+id/buscador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_buscador"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/tenant_search_label"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium"
                android:textColorHint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_filters"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_brand_container"
                android:contentDescription="@string/tenant_filters"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tune"
                app:tint="@color/brand_on_container" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sugerencias (scroll horizontal) (446:3416) -->
    <HorizontalScrollView
        android:id="@+id/sugerencias_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/sugerencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
