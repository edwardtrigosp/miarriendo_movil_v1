<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Arriendo pagado, Abono aprobado y Pago no completado -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".ResultadoPagoActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg"
            android:visibility="invisible"
            tools:visibility="visible">

            <!-- Emblema de estado: el fondo y el color del ícono los pone el código -->
            <ImageView
                android:id="@+id/iv_emblem"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_success"
                android:importantForAccessibility="no"
                android:padding="17dp"
                android:src="@drawable/ic_check"
                app:tint="@color/status_on_success" />

            <TextView
                android:id="@+id/tv_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="Tu pago único fue aprobado." />

            <TextView
                android:id="@+id/tv_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_status"
                style="@style/Widget.Miarriendo.StatusChip.Exito"
                android:layout_marginTop="@dimen/spacing_md"
                tools:text="Pagado" />

            <include
                android:id="@+id/card_detail"
                layout="@layout/view_card_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg" />

            <include
                android:id="@+id/card_payment"
                layout="@layout/view_payment_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_primary"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            tools:text="Ver mi arriendo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_secondary"
            style="@style/Widget.Miarriendo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_xs"
            android:visibility="gone"
            tools:text="Ver comprobante" />
    </LinearLayout>
</LinearLayout>
