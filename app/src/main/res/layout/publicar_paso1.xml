<?xml version="1.0" encoding="utf-8"?>
<!-- Paso 1: Describe tu propiedad (127:1709). Gap entre campos 24 (margen 16 + 8 de la etiqueta). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md">
        <!-- Header: título H1 + subtítulo (patrón de Ingreso con huella) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/publish_step1_title"
            android:textAppearance="@style/TextAppearance.Miarriendo.H1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/publish_step1_subtitle"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_title"
            style="@style/Widget.Miarriendo.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/field_ad_title"
            app:placeholderText="@string/field_ad_title_hint"
            app:startIconDrawable="@drawable/ic_edit">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_title"
                style="@style/Widget.Miarriendo.TextField.EditText"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_description"
            style="@style/Widget.Miarriendo.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/field_description"
            app:placeholderText="@string/field_description_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                style="@style/Widget.Miarriendo.TextArea.EditText" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/publish_type_question"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_type"
            style="@style/Widget.Miarriendo.ChipGroup"
            android:layout_marginTop="@dimen/spacing_sm"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_apartment"
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_apartment" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_house"
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_house" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_studio"
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_studio" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_room"
                style="@style/Widget.Miarriendo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_room" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</ScrollView>
