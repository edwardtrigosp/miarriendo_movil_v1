<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: App actual · inicios. Toda la pantalla es blanca, también detrás de la barra de estado (opción 3 del
     encabezado, 26/10/2026). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    tools:context=".InicioActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_default"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenedor_modulos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Va encima del ScrollView para que se vea mientras carga (antes el fondo blanco tapaba el indicador) -->
    <include layout="@layout/view_inicio_cargando" />
</FrameLayout>
