<?xml version="1.0" encoding="utf-8"?>
<!-- Sugerencia (430:2335), Tono=Claro: ícono de 26 y texto en brand/primary -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="200dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:background="@drawable/bg_sugerencia"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        app:tint="@color/brand_primary"
        tools:src="@drawable/ic_info" />

    <TextView
        android:id="@+id/tv_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
        android:textColor="@color/brand_primary"
        tools:text="@string/home_tip_how_it_works" />
</LinearLayout>
