<?xml version="1.0" encoding="utf-8"?>
<!-- Módulo / Buscar hogar (fila) (482:2350): separador de 8 (como en 05B) y un ListItem que lleva al mapa,
     con borde inferior border/card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Separador: surface/high -->
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/surface_high" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <include
            android:id="@+id/fila"
            layout="@layout/view_list_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/border_width"
            android:background="@color/border_card" />
    </LinearLayout>
</LinearLayout>
