<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Resultados con filtros (315:6696) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".ResultadosActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_lg">

                <!-- Buscar y filtrar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_search"
                        style="@style/Widget.Miarriendo.TextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/filters_city"
                        app:placeholderText="@string/field_city_hint"
                        app:startIconDrawable="@drawable/ic_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_search"
                            style="@style/Widget.Miarriendo.TextField.EditText"
                            android:imeOptions="actionSearch"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/btn_filters"
                        style="@style/Widget.Miarriendo.IconButton"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:contentDescription="@string/tenant_filters"
                        android:src="@drawable/ic_tune" />
                </LinearLayout>

                <!-- Filtros aplicados -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_applied"
                    style="@style/Widget.Miarriendo.ChipGroup"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Resumen de resultados -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                        tools:text="2 propiedades" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/results_order"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/results_end"
                    android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/results_empty"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary" />
    </FrameLayout>
</LinearLayout>
