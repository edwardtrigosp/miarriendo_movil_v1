<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Actual · App › 06 · Inquilino · Explorar en mapa (rediseño 17/10/2026).
     Pantalla secundaria (se entra desde "Buscar en el mapa"): ← Volver, buscador y Filtros arriba; pines solo con
     precio; abajo la hoja con la cantidad de arriendos de la zona visible o la tarjeta de la propiedad tocada.
     El mapa conceptual del diseño es el mapa real de Google Maps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".InquilinoMapaActivity">

    <!-- Mapa / Barra de búsqueda: ← Volver · Ciudad o barrio · Filtros con contador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/spacing_xs">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.Miarriendo.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:contentDescription="@string/map_back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_map_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/tenant_search_label"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_micro">

            <ImageButton
                android:id="@+id/btn_filters"
                style="@style/Widget.Miarriendo.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:contentDescription="@string/tenant_filters"
                android:src="@drawable/ic_tune"
                android:tint="@color/text_primary" />

            <!-- Cuántos filtros están activos; oculto si ninguno -->
            <TextView
                android:id="@+id/tv_filters_count"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_map_filter_badge"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="16dp"
                android:paddingHorizontal="4dp"
                android:textAppearance="@style/TextAppearance.Miarriendo.LabelSmall.Medium"
                android:textColor="@color/surface_white"
                android:visibility="gone"
                tools:text="2"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Filtros activos: cada chip quita su filtro al tocarlo -->
    <HorizontalScrollView
        android:id="@+id/filters_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/spacing_xs"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- Mapa y lo que flota sobre él -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/map_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface_background">

        <!-- Aquí se coloca el SupportMapFragment de Google Maps -->
        <FrameLayout
            android:id="@+id/map"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Sin clave de Google Maps no se puede dibujar el mapa -->
        <LinearLayout
            android:id="@+id/map_unavailable"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/surface_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/map_unavailable_title"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:gravity="center"
                android:text="@string/map_unavailable_text"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Mi ubicación: flota sobre el mapa, encima de la hoja o de la tarjeta -->
        <ImageButton
            android:id="@+id/btn_locate"
            style="@style/Widget.Miarriendo.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@drawable/bg_map_control"
            android:contentDescription="@string/map_center"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/brand_on_container"
            android:outlineSpotShadowColor="@color/brand_on_container"
            android:padding="12dp"
            android:src="@drawable/ic_my_location"
            android:tint="@color/text_primary"
            app:layout_constraintBottom_toTopOf="@id/bottom_barrier"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottom_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="sheet,card_selected" />

        <!-- Mapa / Hoja inferior: cantidad de la zona visible + Ver lista, o el aviso sin resultados -->
        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_property_sheet"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/brand_on_container"
            android:outlineSpotShadowColor="@color/brand_on_container"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_sheet_grip" />

            <LinearLayout
                android:id="@+id/sheet_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                    tools:text="5 arriendos en esta zona" />

                <TextView
                    android:id="@+id/btn_see_list"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/spacing_micro"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/spacing_xs"
                    android:text="@string/map_see_list"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
                    android:textColor="@color/brand_primary"
                    app:drawableEndCompat="@drawable/ic_list"
                    app:drawableTint="@color/brand_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sheet_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/map_empty_filters_title"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

                <TextView
                    android:id="@+id/tv_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_micro"
                    android:text="@string/map_empty_filters_text"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_filters"
                    style="@style/Widget.Miarriendo.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/map_clear_filters" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mapa / Tarjeta seleccionada: lo necesario para decidir si abrir la propiedad -->
        <LinearLayout
            android:id="@+id/card_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_property_sheet"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/brand_on_container"
            android:outlineSpotShadowColor="@color/brand_on_container"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/selected_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_selected_photo"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_map_photo"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:padding="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_work"
                    app:tint="@color/brand_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_selected_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                        tools:text="Casa Los Mayales" />

                    <TextView
                        android:id="@+id/tv_selected_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium"
                        android:textColor="@color/brand_primary"
                        tools:text="$1.200.000 / mes" />

                    <TextView
                        android:id="@+id/tv_selected_zone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        android:textColor="@color/text_secondary"
                        tools:text="Los Mayales · ubicación aproximada" />

                    <TextView
                        android:id="@+id/tv_selected_features"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        android:textColor="@color/text_secondary"
                        tools:text="3 hab. · 2 baños · 110 m²" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_close_card"
                    style="@style/Widget.Miarriendo.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/map_close_card"
                    android:padding="6dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go"
                style="@style/Widget.Miarriendo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/map_go_to_property" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
