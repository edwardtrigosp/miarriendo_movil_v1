<?xml version="1.0" encoding="utf-8"?>
<!-- "Agregar foto" de Reportar un daño: surface/high con borde punteado brand/primary y radio sm -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_high" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_primary"
        android:dashWidth="4dp"
        android:dashGap="4dp" />
    <corners android:radius="@dimen/radius_sm" />
</shape>
