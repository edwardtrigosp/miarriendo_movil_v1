<?xml version="1.0" encoding="utf-8"?>
<!-- Campo del diálogo "Tu celular Nequi" (sugerencia del inicio). Mismo TextField que Pagar con Nequi.
     Va dentro de Dialogo, que ya pone los márgenes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing_xs">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_phone"
        style="@style/Widget.Miarriendo.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nequi_phone_label"
        app:startIconDrawable="@drawable/ic_phone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_phone"
            style="@style/Widget.Miarriendo.TextField.EditText"
            android:imeOptions="actionDone"
            android:inputType="phone"
            android:maxLength="16" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
