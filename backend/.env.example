# Copia este archivo a backend/.env (no se sube a Git) y completa los valores.

# Wompi → comercios.wompi.co → Desarrollo → Programadores (con el modo de pruebas activado).
# Sandbox: pub_test_… / prv_test_… / test_integrity_… / test_events_…  (la privada va solo aquí, en el servidor)
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR

# Firebase → Configuración del proyecto → Cuentas de servicio → "Generar nueva clave privada".
# En local: ruta al .json guardado FUERA del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/fuera/del/repo/miarriendo-cuenta-de-servicio.json
# En un hosting sin archivos: el contenido del .json en una sola línea (en vez de la ruta de arriba).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_DATABASE_URL=https://miarriendo-ff0a9-default-rtdb.firebaseio.com

# El servidor se niega a arrancar con llaves de producción (prod_…) mientras no pongas PERMITIR_PRODUCCION=si.
# PERMITIR_PRODUCCION=

# Opcional. Si defines CRON_SECRET, un cron externo puede llamar a POST /api/cron/estados con la
# cabecera X-Cron-Secret para marcar las cuotas atrasadas.
# CRON_SECRET=
# PORT=8080
