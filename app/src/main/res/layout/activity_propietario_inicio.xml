<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Propietario / Inicio - Sin propiedades (144:1080) y Con propiedades (216:740) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    tools:context=".PropietarioInicioActivity">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/brand_primary" />

    <!-- Estado vacío -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_greeting_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_micro"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodyLarge.Medium"
            tools:text="Hola, Edward!" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/spacing_md">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle_brand_container"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:src="@drawable/ic_home_work" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center"
                android:text="@string/owner_empty_title"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyLarge.Medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:text="@string/owner_empty_subtitle"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_property"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_2xl"
            android:text="@string/owner_add_property" />
    </LinearLayout>

    <!-- Con propiedades (216:740): la lista se desplaza y "Agregar propiedad" queda fijo abajo -->
    <LinearLayout
        android:id="@+id/content_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_lg">

                <!-- Top Bar: saludo + Avatar (abre el perfil) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Miarriendo.H2"
                            tools:text="Hola, Edward" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_micro"
                            android:text="@string/owner_status_today"
                            android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_avatar"
                        style="@style/Widget.Miarriendo.Avatar"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:contentDescription="@string/owner_open_profile"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        tools:text="ET" />
                </LinearLayout>

                <!-- Solicitudes por responder: abre Solicitudes recibidas -->
                <include
                    android:id="@+id/banner_requests"
                    layout="@layout/view_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/owner_my_properties"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

                <!-- Property List: OwnerPropertyCard separadas por spacing/sm -->
                <LinearLayout
                    android:id="@+id/list_properties"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_property_list"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_md"
            android:text="@string/owner_add_property" />
    </LinearLayout>
</FrameLayout>
