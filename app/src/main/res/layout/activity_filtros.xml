<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Filtros de búsqueda (315:6599) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".FiltrosActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Introducción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filters_heading"
                android:textAppearance="@style/TextAppearance.Miarriendo.H2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:text="@string/filters_subtitle"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary" />

            <!-- Ciudad: 24 de separación (16 + 8 de la etiqueta flotante) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_city"
                style="@style/Widget.Miarriendo.TextField.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/filters_city"
                app:startIconDrawable="@drawable/ic_place"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/et_city"
                    style="@style/Widget.Miarriendo.TextField.EditText"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tipo de propiedad -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/filters_type"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_type"
                style="@style/Widget.Miarriendo.ChipGroup"
                android:layout_marginTop="@dimen/spacing_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type_all"
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filters_type_all" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/type_house" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/type_apartment" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/type_studio" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/type_room" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Presupuesto -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/filters_budget"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_price_min"
                    style="@style/Widget.Miarriendo.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/filters_from"
                    app:prefixText="$"
                    app:prefixTextColor="@color/text_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_price_min"
                        style="@style/Widget.Miarriendo.TextField.EditText"
                        android:inputType="number"
                        android:maxLength="13" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_price_max"
                    style="@style/Widget.Miarriendo.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/filters_to"
                    app:prefixText="$"
                    app:prefixTextColor="@color/text_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_price_max"
                        style="@style/Widget.Miarriendo.TextField.EditText"
                        android:inputType="number"
                        android:maxLength="13" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Habitaciones -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/filters_bedrooms"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_bedrooms"
                style="@style/Widget.Miarriendo.ChipGroup"
                android:layout_marginTop="@dimen/spacing_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bedrooms_all"
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filters_bedrooms_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bedrooms_1"
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bedrooms_2"
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bedrooms_3"
                    style="@style/Widget.Miarriendo.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filters_bedrooms_three" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/filters_note"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            tools:text="Ver 2 propiedades" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.Miarriendo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/filters_reset" />
    </LinearLayout>
</LinearLayout>
