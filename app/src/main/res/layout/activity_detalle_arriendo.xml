<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Casa Los Mayales · Detalle (315:6840) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".DetalleArriendoActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Galería de propiedad: fotos deslizables + contador -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_home_work" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_photos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tv_photo_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/spacing_sm"
                    android:background="@drawable/bg_photo_counter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/spacing_micro"
                    android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                    android:textColor="@color/text_primary"
                    android:visibility="gone"
                    tools:text="1 de 4"
                    tools:visibility="visible" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Información de propiedad -->
            <TextView
                android:id="@+id/tv_status"
                style="@style/Widget.Miarriendo.StatusChip.Neutral"
                android:layout_marginTop="20dp"
                android:text="@string/owner_status_available" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Miarriendo.H2"
                tools:text="Casa Los Mayales" />

            <TextView
                android:id="@+id/tv_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="Calle 20 #12-35, Valledupar" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyLarge.Medium"
                android:textColor="@color/brand_primary"
                tools:text="$1.200.000 COP/mes" />

            <!-- Características: entre dos líneas border/card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/border_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bed_double" />

                    <TextView
                        android:id="@+id/tv_feature_bedrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        tools:text="3 habitaciones" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bath" />

                    <TextView
                        android:id="@+id/tv_feature_bathrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        tools:text="2 baños" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feature_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ruler" />

                    <TextView
                        android:id="@+id/tv_feature_area"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        tools:text="110 m²" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_card" />

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/tenant_detail_about"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="Casa luminosa con sala-comedor, cocina amplia y patio." />

            <TextView
                android:id="@+id/tv_amenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                tools:text="Patio · Zona de ropas · Parqueadero" />

            <!-- Propietario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tv_owner_initials"
                    style="@style/Widget.Miarriendo.Avatar"
                    android:importantForAccessibility="no"
                    tools:text="ET" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_owner_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
                        android:textColor="@color/text_primary"
                        tools:text="Edward · Propietario" />

                    <TextView
                        android:id="@+id/tv_owner_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_micro"
                        android:text="@string/tenant_detail_owner_help"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <TextView
            android:id="@+id/tv_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tenant_detail_note"
            android:textAppearance="@style/TextAppearance.Miarriendo.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_request"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_sm"
            android:enabled="false"
            android:text="@string/tenant_detail_request" />

        <!-- Solo en "mi arriendo" (Figma: Inquilino / Detalle de mi arriendo, 621:2047) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report"
            style="@style/Widget.Miarriendo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/my_rental_detail_report"
            android:visibility="gone"
            app:icon="@drawable/ic_build" />
    </LinearLayout>
</LinearLayout>
