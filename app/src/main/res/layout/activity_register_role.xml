<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Onboarding / Registro paso 2 (29:278) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:fillViewport="true"
    tools:context=".RegisterRoleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_2xl">

        <!-- NavBar: flecha de 24dp alineada al margen de 24dp -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="-6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/role_title"
            android:textAppearance="@style/TextAppearance.Miarriendo.H1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/role_subtitle"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />

        <!-- Role Selector: gap 12 entre opciones -->
        <RadioGroup
            android:id="@+id/rg_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:checkedButton="@+id/rb_tenant"
            android:orientation="vertical">

            <android.widget.RadioButton
                android:id="@+id/rb_tenant"
                style="@style/Widget.Miarriendo.RoleOption"
                android:text="@string/role_tenant" />

            <android.widget.RadioButton
                android:id="@+id/rb_owner"
                style="@style/Widget.Miarriendo.RoleOption"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/role_owner" />
        </RadioGroup>

        <!-- Términos: casilla circular 18dp, gap 10 -->
        <android.widget.CheckBox
            android:id="@+id/cb_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:button="@drawable/check_terms"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
            android:textColor="@color/text_terms" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_account"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:text="@string/role_create_account" />
    </LinearLayout>
</ScrollView>
