<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Confirmar en Nequi - Pendiente -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".ConfirmarNequiActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Emblema de estado -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_brand_container"
                android:importantForAccessibility="no"
                android:padding="17dp"
                android:src="@drawable/ic_smartphone"
                app:tint="@color/brand_primary" />

            <TextView
                android:id="@+id/tv_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="Abre Nequi y aprueba el cobro enviado al celular terminado en 4567." />

            <TextView
                android:id="@+id/tv_status"
                style="@style/Widget.Miarriendo.StatusChip.Info"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/pay_status_waiting" />

            <include
                android:id="@+id/card_detail"
                layout="@layout/view_card_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg" />

            <include
                android:id="@+id/alert"
                layout="@layout/view_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_check"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:text="@string/waiting_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_rental"
            style="@style/Widget.Miarriendo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/waiting_back" />
    </LinearLayout>
</LinearLayout>
