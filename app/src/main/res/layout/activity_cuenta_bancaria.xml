<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Registrar cuenta bancaria y Cuenta bancaria registrada (también para el propietario) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".CuentaBancariaActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Formulario -->
                <LinearLayout
                    android:id="@+id/group_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:paddingBottom="@dimen/spacing_lg"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_brand_container"
                        android:importantForAccessibility="no"
                        android:padding="17dp"
                        android:src="@drawable/ic_account_balance"
                        app:tint="@color/brand_primary" />

                    <TextView
                        android:id="@+id/tv_form_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:textAppearance="@style/TextAppearance.Miarriendo.H2"
                        tools:text="Cuenta para devoluciones" />

                    <TextView
                        android:id="@+id/tv_form_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                        tools:text="Solo para devolverte dinero" />

                    <TextView
                        android:id="@+id/tv_form_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                        android:textColor="@color/text_secondary"
                        tools:text="Si hay un pago duplicado…" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_bank"
                        style="@style/Widget.Miarriendo.TextField.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:hint="@string/bank_field_bank"
                        app:startIconDrawable="@drawable/ic_account_balance">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/et_bank"
                            style="@style/Widget.Miarriendo.TextField.EditText"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_type"
                        style="@style/Widget.Miarriendo.TextField.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:hint="@string/bank_field_type"
                        app:startIconDrawable="@drawable/ic_payments">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/et_type"
                            style="@style/Widget.Miarriendo.TextField.EditText"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_number"
                        style="@style/Widget.Miarriendo.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:hint="@string/bank_field_number">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_number"
                            style="@style/Widget.Miarriendo.TextField.EditText"
                            android:inputType="number"
                            android:maxLength="20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_holder"
                        style="@style/Widget.Miarriendo.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:hint="@string/bank_field_holder"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_holder"
                            style="@style/Widget.Miarriendo.TextField.EditText"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="60" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_document"
                        style="@style/Widget.Miarriendo.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:hint="@string/bank_field_document"
                        app:helperText="@string/bank_field_document_help"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_document"
                            style="@style/Widget.Miarriendo.TextField.EditText"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="15" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <include
                        android:id="@+id/alert_form"
                        layout="@layout/view_alert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg" />

                    <TextView
                        android:id="@+id/tv_form_note_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                        android:textColor="@color/text_secondary"
                        tools:text="No te pediremos claves bancarias ni PIN." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save"
                        style="@style/Widget.Miarriendo.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/bank_save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_back_form"
                        style="@style/Widget.Miarriendo.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/bank_back_settings" />
                </LinearLayout>

                <!-- Cuenta guardada -->
                <LinearLayout
                    android:id="@+id/group_saved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:paddingBottom="@dimen/spacing_lg"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_brand_container"
                        android:importantForAccessibility="no"
                        android:padding="17dp"
                        android:src="@drawable/ic_account_balance"
                        app:tint="@color/brand_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/bank_saved_heading"
                        android:textAppearance="@style/TextAppearance.Miarriendo.H2" />

                    <TextView
                        android:id="@+id/tv_saved_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                        tools:text="Solo para devolverte dinero" />

                    <TextView
                        style="@style/Widget.Miarriendo.StatusChip.Primario"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/bank_saved_chip" />

                    <include
                        android:id="@+id/card_saved"
                        layout="@layout/view_card_detalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg" />

                    <include
                        android:id="@+id/alert_saved"
                        layout="@layout/view_alert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md" />

                    <TextView
                        android:id="@+id/tv_saved_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                        android:textColor="@color/text_secondary"
                        tools:text="Esta cuenta no se usa para cobrarte." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_back_saved"
                        style="@style/Widget.Miarriendo.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/bank_back_settings" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit"
                        style="@style/Widget.Miarriendo.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/bank_edit" />
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary" />
    </FrameLayout>
</LinearLayout>
