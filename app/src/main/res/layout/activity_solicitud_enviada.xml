<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Solicitud enviada (315:7044) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".SolicitudEnviadaActivity">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Confirmación -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_circle_brand_container">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_task_alt"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/sent_message"
                android:textAppearance="@style/TextAppearance.Miarriendo.H2" />

            <!-- Resumen de propiedad -->
            <include
                android:id="@+id/card_property"
                layout="@layout/item_propiedad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp" />

            <!-- Próximo paso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_tip_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sent_next_title"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall.Medium"
                    android:textColor="@color/brand_on_container" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/sent_next_text"
                    android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                    android:textColor="@color/brand_on_container" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_my_requests"
            style="@style/Widget.Miarriendo.Button.Primary"
            android:layout_width="match_parent"
            android:text="@string/sent_see_requests" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_keep_exploring"
            style="@style/Widget.Miarriendo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/sent_keep_exploring" />
    </LinearLayout>
</LinearLayout>
