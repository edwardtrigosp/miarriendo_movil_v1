<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Dialog (192:429) en Propietario / Perfil - Confirmar cierre de sesión (193:514) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logout_title"
        android:textAppearance="@style/TextAppearance.Miarriendo.H3" />

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/logout_message"
        android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_cancel"
            style="@style/Widget.Miarriendo.Button.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_confirm"
            style="@style/Widget.Miarriendo.Button.Secondary.Destructivo"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/logout_confirm" />
    </LinearLayout>
</LinearLayout>
