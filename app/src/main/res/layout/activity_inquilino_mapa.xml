<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Inquilino / Mapa · Explorar arriendos (342:2892) y Casa Los Mayales seleccionada (342:3011).
     El mapa conceptual del diseño es el mapa real de Google Maps; los pines se dibujan sobre él. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default"
    android:orientation="vertical"
    tools:context=".InquilinoMapaActivity">

    <!-- Perfil y notificaciones (342:2904): saludo + Avatar que abre el perfil y Mis solicitudes -->
    <LinearLayout style="@style/Widget.Miarriendo.TopAppBar">

        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.Miarriendo.H3"
            tools:text="Hola Edward!" />

        <TextView
            android:id="@+id/tv_avatar"
            style="@style/Widget.Miarriendo.Avatar"
            android:layout_marginStart="@dimen/spacing_micro"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:contentDescription="@string/owner_open_profile"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            tools:text="ET" />

        <ImageButton
            android:id="@+id/btn_my_requests"
            style="@style/Widget.Miarriendo.IconButton"
            android:contentDescription="@string/tenant_my_requests"
            android:src="@drawable/ic_notifications" />
    </LinearLayout>

    <!-- Búsqueda (342:2911): Ciudad o barrio + Filtros; con una propiedad seleccionada aparece "Centrar mapa" (342:3122) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_micro"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_sm">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_search"
            style="@style/Widget.Miarriendo.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/tenant_search_label"
            app:placeholderText="@string/field_city_hint"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                style="@style/Widget.Miarriendo.TextField.EditText"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/btn_locate_inline"
            style="@style/Widget.Miarriendo.IconButton"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_map_control"
            android:contentDescription="@string/map_center"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/brand_on_container"
            android:outlineSpotShadowColor="@color/brand_on_container"
            android:src="@drawable/ic_my_location"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btn_filters"
            style="@style/Widget.Miarriendo.IconButton"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginTop="@dimen/spacing_xs"
            android:contentDescription="@string/tenant_filters"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <!-- Resumen del mapa (342:2925) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_explore_title"
            android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

        <TextView
            android:id="@+id/tv_available"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
            tools:text="3 disponibles" />
    </LinearLayout>

    <!-- Mapa (342:2928) y todo lo que flota sobre él -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/map_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface_background">

        <!-- Aquí se coloca el SupportMapFragment de Google Maps -->
        <FrameLayout
            android:id="@+id/map"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Sin clave de Google Maps no se puede dibujar el mapa -->
        <LinearLayout
            android:id="@+id/map_unavailable"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/surface_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/map_unavailable_title"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:gravity="center"
                android:text="@string/map_unavailable_text"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Referencia cartográfica (342:3001). Queda 36 dp sobre el borde para no tapar el logo de Google. -->
        <TextView
            android:id="@+id/tv_map_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_map_caption"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:paddingVertical="@dimen/spacing_micro"
            android:text="@string/map_attribution"
            android:textAppearance="@style/TextAppearance.Miarriendo.LabelSmall.Medium"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toTopOf="@id/card_selected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="36dp" />

        <!-- Ayuda de exploración (342:3007) -->
        <LinearLayout
            android:id="@+id/card_help"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_map_card"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/brand_on_container"
            android:outlineSpotShadowColor="@color/brand_on_container"
            android:padding="@dimen/spacing_md"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/tv_map_caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_help_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map_help_title"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodyMedium.Medium" />

            <TextView
                android:id="@+id/tv_help_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:text="@string/map_help_text"
                android:textAppearance="@style/TextAppearance.Miarriendo.BodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Control de ubicación (342:3003) -->
        <ImageButton
            android:id="@+id/btn_locate"
            style="@style/Widget.Miarriendo.IconButton"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="31dp"
            android:background="@drawable/bg_map_control"
            android:contentDescription="@string/map_center"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/brand_on_container"
            android:outlineSpotShadowColor="@color/brand_on_container"
            android:src="@drawable/ic_my_location"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/card_help"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <!-- Tarjeta de propiedad seleccionada (342:3126) -->
        <LinearLayout
            android:id="@+id/card_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_property_sheet"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/brand_on_container"
            android:outlineSpotShadowColor="@color/brand_on_container"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Encabezado de tarjeta (342:3127) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/map_selected_label"
                    android:textAppearance="@style/TextAppearance.Miarriendo.Caption" />

                <ImageButton
                    android:id="@+id/btn_close_card"
                    style="@style/Widget.Miarriendo.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/map_close_card"
                    android:padding="4dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- Resumen de propiedad (342:3132) -->
            <include
                android:id="@+id/resumen"
                layout="@layout/view_resumen_propiedad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <!-- Características (342:3146): entre dos líneas border/card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@color/border_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_feature_bed" />

                    <TextView
                        android:id="@+id/tv_feature_bedrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_micro"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        tools:text="3 habitaciones" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_feature_bath" />

                    <TextView
                        android:id="@+id/tv_feature_bathrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_micro"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        tools:text="2 baños" />
                </LinearLayout>

                <Space
                    android:id="@+id/space_area"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/feature_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_feature_ruler" />

                    <TextView
                        android:id="@+id/tv_feature_area"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_micro"
                        android:textAppearance="@style/TextAppearance.Miarriendo.Caption"
                        tools:text="110 m²" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_card" />

            <!-- Ir a propiedad: PrimaryButton -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go"
                style="@style/Widget.Miarriendo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/map_go_to_property" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
